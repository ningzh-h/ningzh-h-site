# Vite 8 / Astro 7 的若干可选 peer 依赖（vitest、webdriverio、puppeteer 等）
# 会让 npm 12 在安装阶段反复解析并卡住。本项目不需要它们，
# 因此关闭 peer 依赖的自动安装。依赖本身仍在 package.json 中显式声明。
legacy-peer-deps=true

# package-lock 里的 tarball 地址可能来自镜像；安装时按 registry 替换，
# 避免 npm 12 因跨域名 tarball 报 EALLOWREMOTE。
registry=https://registry.npmmirror.com
replace-registry-host=always
