---
import { siteConfig } from '../site.config';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const yearLabel = siteConfig.since === year ? `${year}` : `${siteConfig.since}–${year}`;
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {yearLabel} {siteConfig.name} · 用 Markdown 写作，用 Astro 构建</p>
    <nav class="footer-links" aria-label="页脚链接">
      {
        siteConfig.socials.map((social) => (
          <a
            href={social.href.startsWith('/') ? withBase(social.href) : social.href}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            target={social.href.startsWith('http') ? '_blank' : undefined}
          >
            {social.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
