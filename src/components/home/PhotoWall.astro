---
import { withBase } from '../../lib/url';

interface Photo {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos?: Photo[];
}

const { photos = [] } = Astro.props;
---

{
  photos.length > 0 && (
    <section class="home-photos" aria-label="照片">
      <div class="photo-grid">
        {photos.map((photo) => (
          <a
            class="photo-item"
            href={withBase(photo.src)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={withBase(photo.src)} alt={photo.alt} loading="lazy" />
            {photo.caption && <span class="photo-caption">{photo.caption}</span>}
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .home-photos {
    margin-top: 30px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }

  .photo-item {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .photo-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .photo-item:hover img {
    transform: scale(1.03);
  }

  .photo-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    color: #fff;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
