---
import { siteConfig } from '../site.config';
import { isActivePath, withBase } from '../lib/url';

const pathname = Astro.url.pathname;

const accentThemes = [
  { value: 'pine', label: '墨绿', color: '#2f6f62' },
  { value: 'mist', label: '雾蓝', color: '#3b6385' },
  { value: 'clay', label: '赭石', color: '#9a5b3f' },
  { value: 'plum', label: '紫棠', color: '#6b4a7a' },
  { value: 'ink', label: '炭黑', color: '#4b4b4b' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${siteConfig.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" focusable="false">
          <rect width="64" height="64" rx="16" fill="currentColor"></rect>
          <path
            d="M20 46V18l24 28V18"
            fill="none"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span>{siteConfig.name}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a
            class="nav-link"
            href={withBase(item.href)}
            aria-current={isActivePath(pathname, item.match) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="搜索站点">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <span>搜索</span>
        <kbd class="kbd">Ctrl K</kbd>
      </button>

      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换主题">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="accent-picker" data-accent-picker>
        <button
          class="icon-btn"
          type="button"
          data-accent-toggle
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="切换颜色主题"
          title="切换颜色主题"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path
              d="M12 21a9 9 0 1 1 9-9c0 2.2-1.8 4-4 4h-1.5a2.5 2.5 0 0 0-1.8 4.2c.5.5.8 1 .8 1.8Z"
              stroke-linejoin="round"></path>
            <circle cx="7.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"></circle>
            <circle cx="10.5" cy="7" r="1.1" fill="currentColor" stroke="none"></circle>
            <circle cx="15" cy="7.5" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </button>

        <div class="accent-menu" data-accent-menu hidden>
          <p class="accent-menu-title">颜色主题</p>
          {
            accentThemes.map((theme) => (
              <button
                class="accent-option"
                type="button"
                data-accent-value={theme.value}
                aria-pressed={theme.value === 'pine' ? 'true' : 'false'}
              >
                <span class="accent-swatch" style={`--swatch:${theme.color}`}></span>
                <span>{theme.label}</span>
              </button>
            ))
          }
        </div>
      </div>

      <button
        class="icon-btn menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开导航菜单"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="shell">
    <nav class="mobile-nav" id="mobile-nav" data-mobile-nav hidden aria-label="移动端导航">
      {
        siteConfig.nav.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActivePath(pathname, item.match) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
