---
import { withBase } from '../lib/url';

const indexUrl = withBase('/search-index.json');
---

<dialog class="search-dialog" data-search-dialog data-index-url={indexUrl} aria-label="搜索站点">
  <form class="search-form" data-search-form role="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
    </svg>
    <input
      class="search-input"
      type="search"
      name="q"
      placeholder="搜索文章、书籍、章节…"
      autocomplete="off"
      spellcheck="false"
      aria-label="搜索关键词"
      data-search-input
    />
    <kbd class="kbd search-esc">Esc</kbd>
  </form>
  <ul class="search-results" data-search-results aria-live="polite"></ul>
  <p class="search-empty" data-search-empty hidden>没有找到匹配的内容。</p>
  <p class="search-hint">↑↓ 选择 · Enter 打开 · Esc 关闭</p>
</dialog>

<script>
  interface SearchItem {
    title: string;
    url: string;
    description: string;
    tags: string[];
    type: 'post' | 'note' | 'chapter' | 'recreation' | 'card' | 'page';
    text: string;
  }

  type MatchRange = readonly [number, number];

  interface FuseMatch {
    key?: string;
    indices: ReadonlyArray<MatchRange>;
  }

  interface FuseResultItem {
    item: SearchItem;
    matches?: FuseMatch[];
  }

  interface FuseLike {
    search(query: string): FuseResultItem[];
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const list = document.querySelector<HTMLUListElement>('[data-search-results]');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const form = document.querySelector<HTMLFormElement>('[data-search-form]');

  const typeLabels: Record<SearchItem['type'], string> = {
    post: '文章',
    note: '笔记',
    chapter: '章节',
    recreation: '书影音',
    card: '卡片',
    page: '页面',
  };

  let fuse: FuseLike | null = null;
  let items: SearchItem[] = [];
  let loadPromise: Promise<void> | null = null;
  let results: Array<{ item: SearchItem; titleMatches?: ReadonlyArray<MatchRange> }> = [];
  let activeIndex = -1;

  function setEmptyMessage(message: string | null) {
    if (!empty) return;
    if (message) {
      empty.textContent = message;
      empty.hidden = false;
    } else {
      empty.hidden = true;
    }
  }

  async function ensureIndex(): Promise<void> {
    if (fuse || !dialog) return;
    if (loadPromise) return loadPromise;

    loadPromise = (async () => {
      setEmptyMessage('正在加载索引…');
      try {
        const [{ default: FuseCtor }, response] = await Promise.all([
          import('fuse.js'),
          fetch(dialog.dataset.indexUrl || '/search-index.json'),
        ]);
        if (!response.ok) throw new Error(`索引请求失败：${response.status}`);
        items = (await response.json()) as SearchItem[];
        const Fuse = FuseCtor as unknown as new (
          list: SearchItem[],
          options: Record<string, unknown>,
        ) => FuseLike;
        fuse = new Fuse(items, {
          keys: [
            { name: 'title', weight: 0.55 },
            { name: 'tags', weight: 0.25 },
            { name: 'description', weight: 0.12 },
            { name: 'text', weight: 0.08 },
          ],
          threshold: 0.3,
          ignoreLocation: true,
          minMatchCharLength: 1,
          includeMatches: true,
          includeScore: true,
        });
        setEmptyMessage(null);
      } catch (error) {
        console.error(error);
        setEmptyMessage('搜索索引加载失败，请刷新页面后重试。');
      }
    })();

    return loadPromise;
  }

  function highlight(container: HTMLElement, text: string, ranges?: ReadonlyArray<MatchRange>) {
    if (!ranges || ranges.length === 0) {
      container.textContent = text;
      return;
    }
    let cursor = 0;
    for (const [start, end] of ranges) {
      if (start > cursor) container.append(document.createTextNode(text.slice(cursor, start)));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(start, end + 1);
      container.append(mark);
      cursor = end + 1;
    }
    if (cursor < text.length) container.append(document.createTextNode(text.slice(cursor)));
  }

  function updateActive(next: number) {
    const nodes = list?.querySelectorAll<HTMLAnchorElement>('.search-result');
    if (!nodes || nodes.length === 0) return;
    activeIndex = (next + nodes.length) % nodes.length;
    nodes.forEach((node, index) => node.classList.toggle('is-active', index === activeIndex));
    nodes[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function render() {
    if (!list || !input) return;
    list.replaceChildren();
    activeIndex = -1;

    if (results.length === 0) {
      setEmptyMessage(input.value.trim() ? '没有找到匹配的内容。' : null);
      return;
    }
    setEmptyMessage(null);

    results.forEach((result) => {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = result.item.url;

      const title = document.createElement('div');
      title.className = 'search-result-title';
      highlight(title, result.item.title, result.titleMatches);

      const meta = document.createElement('div');
      meta.className = 'search-result-meta';
      const type = document.createElement('span');
      type.textContent = typeLabels[result.item.type] ?? '内容';
      meta.append(type);
      if (result.item.tags.length > 0) {
        const tags = document.createElement('span');
        tags.textContent = result.item.tags.slice(0, 3).join(' · ');
        meta.append(tags);
      }
      if (result.item.description) {
        const desc = document.createElement('span');
        desc.textContent = result.item.description;
        meta.append(desc);
      }

      link.append(title, meta);
      li.append(link);
      list.append(li);
    });
  }

  function search(query: string) {
    const keyword = query.trim();
    if (!keyword) {
      results = items.slice(0, 8).map((item) => ({ item }));
      render();
      return;
    }
    const found = fuse?.search(keyword) ?? [];
    results = found.slice(0, 12).map((entry) => ({
      item: entry.item,
      titleMatches: entry.matches?.find((match) => match.key === 'title')?.indices,
    }));
    render();
    if (results.length > 0) updateActive(0);
  }

  async function openDialog() {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    await ensureIndex();
    if (input) input.value = '';
    search('');
    input?.focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((button) => {
    button.addEventListener('click', () => void openDialog());
  });

  input?.addEventListener('input', () => search(input.value));

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      updateActive(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      updateActive(activeIndex - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const target = results[activeIndex]?.item ?? results[0]?.item;
      if (target) window.location.href = target.url;
    }
  });

  form?.addEventListener('submit', (event) => event.preventDefault());

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.matches('input, textarea, select, [contenteditable="true"]') ?? false;
    const isShortcut =
      ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') ||
      (event.key === '/' && !typing);

    if (isShortcut && !dialog?.open) {
      event.preventDefault();
      void openDialog();
    }
  });
</script>
