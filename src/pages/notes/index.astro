---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getBooks } from '../../lib/content';
import { fillCopy } from '../../lib/copy';
import { siteConfig } from '../../site.config';

const books = await getBooks();
const reading = books.filter((book) => book.status === 'reading').length;
const copy = siteConfig.copy.notes;
const lede = fillCopy(copy.lede, { count: books.length, reading });
---

<BaseLayout title={copy.title} description={lede}>
  <div class="shell page">
    <header class="page-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="page-title">{copy.title}</h1>
      <p class="page-lede">{lede}</p>
    </header>

    {
      books.length > 0 ? (
        <div class="book-grid">
          {books.map((book) => (
            <BookCard book={book} />
          ))}
        </div>
      ) : (
        <p class="empty">笔记还是空的。在 `src/content/notes/` 下新建一篇吧。</p>
      )
    }
  </div>
</BaseLayout>
