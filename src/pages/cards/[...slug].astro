---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import TagList from '../../components/TagList.astro';
import { getCards } from '../../lib/cards';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const cards = await getCards();
  return cards.map((card) => ({
    params: { slug: card.id },
    props: { cardId: card.id },
  }));
}

interface Props {
  cardId: string;
}

const { cardId } = Astro.props;
const cards = await getCards();
const card = cards.find((item) => item.id === cardId);

if (!card) {
  throw new Error(`[cards] 找不到卡片：${cardId}`);
}

const { Content } = await render(card.entry);
const displayTitle = card.entry.data.title ?? '无题';
---

<BaseLayout title={displayTitle} description={card.excerpt}>
  <div class="shell page">
    <article class="card-article">
      <BackLink href="/cards/" label="返回卡片" />

      <header class="article-header">
        <div class="article-meta">
          {card.group && <span>{card.group}</span>}
          {card.group && <span aria-hidden="true">·</span>}
          {card.date && <time datetime={card.date.toISOString()}>{formatDate(card.date)}</time>}
        </div>
        <h1 class="article-title">{displayTitle}</h1>
        <div style="margin-top:14px">
          <TagList tags={card.tags} linked={false} />
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
