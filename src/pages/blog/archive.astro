---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { getPosts, postHref, type BlogPost } from '../../lib/content';
import { formatDate } from '../../lib/format';

const posts = await getPosts();
const byYear = new Map<number, BlogPost[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const list = byYear.get(year) ?? [];
  list.push(post);
  byYear.set(year, list);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="归档" description="按时间排列的全部文章。">
  <div class="shell page">
    <BackLink href="/blog/" label="返回博客" />

    <header class="page-header">
      <p class="eyebrow">Archive</p>
      <h1 class="page-title">归档</h1>
      <p class="page-lede">从最近的一篇往前读。</p>
    </header>

    {
      years.map(([year, list]) => (
        <section class="year-group" aria-label={`${year} 年`}>
          <p class="year-label">{year}</p>
          <ul class="archive-list">
            {list.map((post) => (
              <li class="archive-item">
                <time class="archive-date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date).replace('年', '-').replace('月', '-').replace('日', '')}
                </time>
                <a class="archive-title" href={postHref(post.id)}>
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
