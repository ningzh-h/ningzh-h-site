---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPostNeighbors, getPosts, type BlogPost } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const { prev, next } = getPostNeighbors(posts, post.id);
---

<BlogPostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</BlogPostLayout>
