---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackLink from '../../../components/BackLink.astro';
import PostCard from '../../../components/PostCard.astro';
import {
  getPostGroups,
  getPosts,
  postGroup,
  postGroupLabel,
} from '../../../lib/content';

export async function getStaticPaths() {
  const groups = getPostGroups(await getPosts());
  return groups.map((group) => ({
    params: { group: group.group },
    props: { group: group.group },
  }));
}

interface Props {
  group: string;
}

const { group } = Astro.props;
const posts = (await getPosts()).filter((post) => postGroup(post.id) === group);
const label = postGroupLabel(group);
---

<BaseLayout title={`${label} · 博客`} description={`分组「${label}」下的文章。`}>
  <div class="shell page">
    <BackLink href="/blog/groups/" label="返回分组" />

    <header class="page-header">
      <p class="eyebrow">Group</p>
      <h1 class="page-title">{label}</h1>
      <p class="page-lede">共 {posts.length} 篇。</p>
    </header>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
