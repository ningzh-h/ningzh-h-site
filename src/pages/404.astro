---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。" noIndex>
  <div class="shell page" style="text-align:center; padding-top:96px">
    <p class="eyebrow" style="justify-content:center">404</p>
    <h1 class="page-title">这里什么都没有</h1>
    <p class="page-lede" style="margin-left:auto;margin-right:auto;max-width:28rem">
      可能是链接写错了，也可能是这篇内容还没写。你可以回到首页，或者去博客逛逛。
    </p>
    <div class="hero-actions" style="justify-content:center;margin-top:28px">
      <a class="btn btn--primary" href={withBase('/')}>回首页</a>
      <a class="btn" href={withBase('/blog/')}>看博客</a>
    </div>
  </div>
</BaseLayout>
