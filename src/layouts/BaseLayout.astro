---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/prose.css';
import 'katex/dist/katex.min.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = siteConfig.description,
  type = 'website',
  noIndex = false,
  bodyClass,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogTitle = title ? `${title} · ${siteConfig.name}` : siteConfig.title;
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-accent="pine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    {noIndex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={`${import.meta.env.BASE_URL}rss.xml`} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;

          var accents = ['pine', 'mist', 'clay', 'plum', 'ink'];
          var accent = localStorage.getItem('accent');
          document.documentElement.dataset.accent =
            accents.indexOf(accent) >= 0 ? accent : 'pine';
        } catch (error) {
          /* 忽略隐私模式下的 localStorage 异常 */
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog />

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      function syncThemeLabel() {
        if (!themeToggle) return;
        const isDark = root.dataset.theme === 'dark';
        themeToggle.setAttribute('aria-label', isDark ? '切换到亮色模式' : '切换到暗色模式');
        themeToggle.setAttribute('title', isDark ? '切换到亮色模式' : '切换到暗色模式');
      }

      themeToggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
        syncThemeLabel();
      });

      syncThemeLabel();

      const accentPicker = document.querySelector<HTMLElement>('[data-accent-picker]');
      const accentToggle = accentPicker?.querySelector<HTMLButtonElement>('[data-accent-toggle]');
      const accentMenu = accentPicker?.querySelector<HTMLElement>('[data-accent-menu]');
      const accentOptions = Array.from(
        accentPicker?.querySelectorAll<HTMLButtonElement>('[data-accent-value]') ?? [],
      );
      const accentValues = accentOptions.map((option) => option.dataset.accentValue ?? '');

      function syncAccent() {
        const current = root.dataset.accent ?? 'pine';
        for (const option of accentOptions) {
          option.setAttribute('aria-pressed', String(option.dataset.accentValue === current));
        }
      }

      function setAccentMenu(open: boolean) {
        if (!accentToggle || !accentMenu) return;
        accentToggle.setAttribute('aria-expanded', String(open));
        if (open) accentMenu.removeAttribute('hidden');
        else accentMenu.setAttribute('hidden', '');
      }

      accentToggle?.addEventListener('click', () => {
        const expanded = accentToggle.getAttribute('aria-expanded') === 'true';
        setAccentMenu(!expanded);
      });

      accentOptions.forEach((option) => {
        option.addEventListener('click', () => {
          const next = option.dataset.accentValue ?? '';
          if (!accentValues.includes(next)) return;
          root.dataset.accent = next;
          try {
            localStorage.setItem('accent', next);
          } catch {
            /* ignore */
          }
          syncAccent();
          setAccentMenu(false);
        });
      });

      document.addEventListener('click', (event) => {
        if (!accentPicker || !accentMenu || accentMenu.hasAttribute('hidden')) return;
        if (event.target instanceof Node && !accentPicker.contains(event.target)) {
          setAccentMenu(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setAccentMenu(false);
      });

      syncAccent();

      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

      function setMenu(open: boolean) {
        if (!menuToggle || !mobileNav) return;
        menuToggle.setAttribute('aria-expanded', String(open));
        if (open) {
          mobileNav.removeAttribute('hidden');
        } else {
          mobileNav.setAttribute('hidden', '');
        }
      }

      menuToggle?.addEventListener('click', () => {
        const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenu(!expanded);
      });

      mobileNav?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setMenu(false);
      });

      // 代码块：加语言标签和复制按钮
      document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
        if (pre.closest('.code-block')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        const toolbar = document.createElement('div');
        toolbar.className = 'code-toolbar';

        const language = document.createElement('span');
        language.textContent = pre.dataset.language || 'code';

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy-btn';
        copy.textContent = '复制';
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            copy.textContent = '已复制';
            window.setTimeout(() => {
              copy.textContent = '复制';
            }, 1600);
          } catch {
            copy.textContent = '复制失败';
          }
        });

        toolbar.append(language, copy);
        pre.replaceWith(wrapper);
        wrapper.append(toolbar, pre);
      });
    </script>
  </body>
</html>
